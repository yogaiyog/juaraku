{
  "name": "scratch-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "dotenv -e .env.local -- next dev",
    "dev:supabase": "dotenv -e .env.development -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "tsx --env-file=.env scripts/sync-to-minio.ts",
    "sync-local": "dotenv -e .env.local -- tsx scripts/sync-to-minio.ts",
    "sync-content": "dotenv -e .env -e .env.development -- tsx scripts/sync-content-from-minio.ts",
    "sync-content-local": "dotenv -e .env -e .env.local -- tsx scripts/sync-content-from-minio.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@prisma/client": "^6.19.3",
    "@prisma/pg-worker": "^6.9.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.1",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "scratchblocks": "^3.7.0",
    "unified": "^11.0.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcrypt": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
